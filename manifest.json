{
  "manifest_version": 3,
  "name": "Calculator",
  "version": "1.0.0",
  "description": "Calculate Anywhere",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icons16.png",
      "48": "img/icons48.png",
      "128": "img/icons128.png"
    }
  },
  "icons": {
    "16": "img/icons16.png",
    "48": "img/icons48.png",
    "128": "img/icons128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "web_accessible_resources": [{
    "resources": ["img/*", "assets/*"],
    "matches": ["<all_urls>"]
  }]
}
